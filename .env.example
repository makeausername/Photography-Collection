# 首次启动时生效。请改成你自己的长密码，不要使用示例值。
ADMIN_PASSWORD=

# 上线后填写网站的 HTTPS 根地址，用于分享链接和二维码。
PUBLIC_BASE_URL=

# 默认本地图片存储，作品资料自动保存在 DATA_DIR/portfolio.sqlite。
STORAGE_PROVIDER=local
# 非 Docker 运行时可指定数据目录；Docker 使用 /app/data。
DATA_DIR=./data

# 启用 OSS 时将 STORAGE_PROVIDER 改为 oss，并填写以下五项。
# Bucket 和 Object 均保持私有。仅使用专用 RAM 身份，不要使用主账号密钥。
OSS_REGION=oss-cn-hangzhou
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
# 绑定到 OSS 的 HTTPS 自定义域名，仅填根地址。
OSS_PUBLIC_BASE_URL=
# 可选：服务器访问 OSS 的端点。同地域阿里云服务器可填内网 HTTPS 端点。
OSS_ENDPOINT=
OSS_PREFIX=portfolio
OSS_URL_TTL=300
# 可选临时凭证；过期前需更新并重启，不会自动刷新。
OSS_STS_TOKEN=

# 可选 CDN：两个字段必须一起填写，控制台启用 A 类型 URL 鉴权。
# CDN 有效时长在阿里云控制台设为 300 秒；这里的 OSS_URL_TTL 不控制 CDN。
CDN_BASE_URL=
CDN_AUTH_KEY=

# 自动备份目录（可挂载独立磁盘）；留空使用 DATA_DIR/auto-backups。
# 在后台“存储与备份”启用计划，默认关闭；配置下面的备份专用 OSS 后会自动同步。
BACKUP_DIR=

# 异地备份独立配置，密钥只写服务器私有配置，不进入 Git。
BACKUP_OSS_REGION=oss-cn-hangzhou
BACKUP_OSS_BUCKET=
BACKUP_OSS_ACCESS_KEY_ID=
BACKUP_OSS_ACCESS_KEY_SECRET=
BACKUP_OSS_PREFIX=kosmoyonder-backups
